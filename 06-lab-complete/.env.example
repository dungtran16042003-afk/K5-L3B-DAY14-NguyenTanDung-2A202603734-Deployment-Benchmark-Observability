# Dùng: cp .env.example .env  rồi điền giá trị (file .env đã nằm trong .gitignore)
# KHÔNG ghi secret thật vào file này.

# Cổng app lắng nghe (cloud platform tự cấp biến này)
PORT=8000
ENVIRONMENT=development

# Khoá gọi /ask qua header X-API-Key. Tự sinh một chuỗi ngẫu nhiên, ví dụ:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Để trống thì mọi request /ask bị 401.
AGENT_API_KEY=

# Redis dùng cho rate limit và cost guard
REDIS_URL=redis://localhost:6379/0

# Số request tối đa mỗi phút cho một API key
RATE_LIMIT_PER_MINUTE=10

# Ngân sách LLM tối đa mỗi ngày (USD)
DAILY_BUDGET_USD=1.0
